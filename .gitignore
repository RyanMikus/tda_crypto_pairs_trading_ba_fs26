# Python
__pycache__/
*.pyc
.pytest_cache/

# Environments
.env/
.venv/
env/
.envs/

# IDE
.vscode/
.idea/
.claude/

# Notebook cache
.ipynb_checkpoints/

# Secrets
.env

# Logs
*.log

secret.cfg

# Raw API response cache (dev-time, resumable fetch checkpoints)
data/raw/cache/

# Regenerable notebook outputs (rerun the notebooks to recreate)
data/processed/plots/
data/processed/features/

# Backtest run artifacts (regenerable via 03_backtest/*.ipynb) -- nur der
# leichtgewichtige Index bleibt getrackt (data/processed/backtests/_index.parquet),
# damit die Run-Historie im Repo nachvollziehbar bleibt, ohne die schweren
# equity_curve/trades-Parquets pro Run mitzupushen.
data/processed/backtests/*/

# Optuna-Tuning-Storage (regenerable via src/backtest/tuning.py) -- dasselbe
# Prinzip wie bei den Backtest-Run-Artefakten oben, hier ohne getrackten Index.
# README.md bleibt Ausnahme (erklaert Herkunft/Format, kein regenerierbares Artefakt) --
# data/processed/tuning/* (statt .../tuning/) noetig, damit Git ueberhaupt in den Ordner
# hineinschaut und die !-Ausnahme unten greifen kann (ein reines Verzeichnis-Pattern
# wuerde den Ordner komplett blocken, Datei-Ausnahmen darin waeren wirkungslos).
data/processed/tuning/*
!data/processed/tuning/README.md

# Gleiches Prinzip fuer den finalen Tuning-Dbstore: die grossen, regenerierbaren
# OHLCV-Preis-Caches (.pkl) nicht tracken, die kleinen best_params.json (die
# eigentlichen Tuning-Ergebnisse) bleiben ueber die Ausnahme getrackt.
data/processed/tuning_dbstore_final/*/*
!data/processed/tuning_dbstore_final/*/best_params.json

# Generierter pytest-Report (regenerierbar via notebooks/run_tests.ipynb / pytest)
tests/.last_run_report.xml
